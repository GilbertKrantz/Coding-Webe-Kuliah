@model IEnumerable<WareHouseT2.Models.Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container flex-start">
    <div class="category container">
        <h1 class="title">Category</h1>
        <button class="blue-safe" ><a asp-action="Create">Add Category</a></button>
        <table class="table">
            <thead>
                <tr>
                    <th>id</th>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelitem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="button-container">
                            <button class="yellow-warning"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></button>
                            <button class="red-danger"><a asp-action="Delete" asp-route-id="@item.Id">Delete</a></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
