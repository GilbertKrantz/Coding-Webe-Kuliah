<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WareHouseT2</title>
    <link rel="stylesheet" href="~/WareHouseT2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1 class="brand">WearHouse</h1>
        <nav class="nav">
            <ul class="left links">
                <li><a asp-area="" asp-controller="Categories" asp-action="index" class="link">Category</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="index" class="link">About Us</a></li>
            </ul>
            <ul class="right links">
                <partial name="_LoginPartial.cshtml" />
            </ul>
        </nav>
        <div class="btn-container"><i class="fa-solid fa-bars menu-btn"></i></div>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <i class="fa-brands fa-twitter brand-icon"><a href=""></a></i>
        <i class="fa-brands fa-facebook brand-icon"><a href=""></a></i>
        <i class="fa-brands fa-instagram brand-icon"><a href=""></a></i>
        <div class="copyright">
            <p>Copyright &copy; 2021 Wilbert Chandra. All Right Reserved</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://kit.fontawesome.com/df5d4ed108.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
