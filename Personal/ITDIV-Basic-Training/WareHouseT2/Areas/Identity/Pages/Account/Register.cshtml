@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container">
    <div class="register-container container">
        <div class="title-container"><h1 class="register-title title">Register</h1></div>
        <div class="register-box box">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="input-container">
                    <label asp-for="Input.Name"></label>
                    <input asp-for="Input.Name" class="input-field" autocomplete="" aria-required="true" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="input-container">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="input-field" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="input-container">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="input-field" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="input-container">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="input-field" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="input-container checkbox-container">
                    <input asp-for="Input.TermAndCondition" class="checkbox" autocomplete="" type="checkbox" />
                    <span asp-validation-for="Input.TermAndCondition" class="text-danger"></span>
                    <label asp-for="Input.TermAndCondition"></label>
                </div>
                <div class="input-container submit">
                    <button id="registerSubmit" type="submit" class="btn">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
