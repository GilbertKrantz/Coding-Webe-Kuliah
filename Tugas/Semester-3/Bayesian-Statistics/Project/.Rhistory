# Load Function
## SVSS
SVSS_cal <- function(sample) {
beta <- NULL
for(l in 1:n.chains){
beta <- rbind(beta,sample[[l]])
}
library(knitr)
Inc_Prob <- apply(beta!=0,2,mean)
Q <- t(apply(beta,2,quantile,c(0.5,0.05,0.95)))
out <- cbind(Inc_Prob,Q)
kable(round(out,2))
}
