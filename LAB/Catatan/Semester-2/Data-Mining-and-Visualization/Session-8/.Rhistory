extreme_values <- function(data, variable) {
# Calculate the IQR of the variable
iqr <- IQR(data[[variable]])
# Calculate the lower and upper bounds for outliers
lower_bound <- quantile(data[[variable]], 0.25) - 1.5 * iqr
upper_bound <- quantile(data[[variable]], 0.75) + 1.5 * iqr
# Count the number of extreme values
num_extreme_values <- sum(data[[variable]] < lower_bound | data[[variable]] > upper_bound)
# Create a table with the results
result_table <- data.frame(
Variable = variable,
IQR = iqr,
Lower_Bound = lower_bound,
Upper_Bound = upper_bound,
Num_Extreme_Values = num_extreme_values
)
return(result_table)
}
extreme_values(msleep, sleep_total)
