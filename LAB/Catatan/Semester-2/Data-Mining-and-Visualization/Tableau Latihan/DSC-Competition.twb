    <worksheet name='Distribution of records by Genre 1 of Walt Disney Studios Motion Pictures'>
      <layout-options export-legend-location='bottom' export-map-legend='false' export-no-caption='true' export-no-title='true' export-shape-legend='false' export-size-legend='false'>
        <title>
          <formatted-text>
            <run>Distribution of records by Genre 1 of Walt Disney Studios Motion Pictures</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Worksheet (Highest-Holywood-Grossing-Movies)' name='federated.1qqx7vw1j3zdeq1g866j01pcxa2u' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='federated.1qqx7vw1j3zdeq1g866j01pcxa2u'>
            <column caption='All Marks' datatype='real' name='[Calculation_2144276402085531699]' role='measure' type='quantitative' user:unnamed='Distribution of records by Genre 1 of Walt Disney Studios Motion Pictures'>
              <calculation class='tableau' formula='//All Marks&#10;COUNT(ISNULL([Genre - Split 2])) / WINDOW_SUM(COUNT(ISNULL([Genre - Split 2])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Analyzed Mark' datatype='real' name='[Calculation_2144276402085531700]' role='measure' type='quantitative' user:unnamed='Distribution of records by Genre 1 of Walt Disney Studios Motion Pictures'>
              <calculation class='tableau' formula='//Analyzed Mark&#10;COUNT(IIF([Distributor]&#10; = &quot;Walt Disney Studios Motion Pictures&quot;, ISNULL([Genre - Split 2]), NULL)) / WINDOW_SUM(COUNT(IIF([Distributor]&#10; = &quot;Walt Disney Studios Motion Pictures&quot;, ISNULL([Genre - Split 2]), NULL)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Difference of All Marks &amp; Walt Disney Studios Motion Pictures' datatype='real' name='[Calculation_2144276402085531701]' role='measure' type='quantitative' user:unnamed='Distribution of records by Genre 1 of Walt Disney Studios Motion Pictures'>
              <calculation class='tableau' formula='// Difference of All Marks &amp; Walt Disney Studios Motion Pictures &#10;ABS( COUNT([Genre - Split 2]) / SUM({EXCLUDE [Genre - Split 2] : COUNT([Genre - Split 2])}) - COUNT(IIF([Distributor]&#10; = &quot;Walt Disney Studios Motion Pictures&quot;, [Genre - Split 2], NULL)) / SUM({EXCLUDE [Genre - Split 2] : COUNT(IIF([Distributor]&#10; = &quot;Walt Disney Studios Motion Pictures&quot;, [Genre - Split 2], NULL))}) )' />
            </column>
            <column datatype='string' name='[Distributor]' role='dimension' type='nominal' />
            <column caption='Genre 1' datatype='string' name='[Genre - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.1qqx7vw1j3zdeq1g866j01pcxa2u].[Genre]'>
              <calculation class='tableau' formula='TRIM( SPLIT( [Genre], &quot;&apos;&quot;, 2 ) )' />
            </column>
            <column datatype='string' name='[Genre]' role='dimension' type='nominal' />
            <column-instance column='[Genre - Split 2]' derivation='None' name='[none:Genre - Split 2:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2144276402085531699]' derivation='User' name='[usr:Calculation_2144276402085531699:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1qqx7vw1j3zdeq1g866j01pcxa2u].[none:Genre - Split 2:nk]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_2144276402085531700]' derivation='User' name='[usr:Calculation_2144276402085531700:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1qqx7vw1j3zdeq1g866j01pcxa2u].[none:Genre - Split 2:nk]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_2144276402085531701]' derivation='User' name='[usr:Calculation_2144276402085531701:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
