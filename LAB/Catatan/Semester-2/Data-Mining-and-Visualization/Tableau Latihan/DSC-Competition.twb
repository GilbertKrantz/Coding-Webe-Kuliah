      <column caption='International Sales Proportion' datatype='real' name='[Calculation_2144276402070458368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(sum([International Sales (in $)])/sum([World Sales (in $)])*100,0)' />
      </column>
      <column caption='Domestic Sales Proportion' datatype='real' name='[Calculation_2144276402070855681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(SUM([Domestic Sales (in $)])/sum([World Sales (in $)])*100, 0)' />
      </column>
      <column caption='Movie Hours' datatype='integer' name='[Calculation_2144276402077896709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(SPLIT([Movie Runtime], &quot; &quot;, 1))' />
      </column>
      <column caption='Movie Minutes' datatype='integer' name='[Calculation_2144276402078060550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(SPLIT([Movie Runtime], &quot; &quot;, 3))' />
      </column>
      <column caption='Movie Runtime (Minutes)' datatype='integer' name='[Calculation_2144276402078195719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2144276402077896709]*60 + [Calculation_2144276402078060550]' />
      </column>
      <column caption='Movie Info Length' datatype='integer' name='[Calculation_2144276402096250934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LEN([Movie Info])' />
      </column>
      <column caption='Genre Action' datatype='string' name='[Calculation_2297398790118682626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Genre], &apos;Action&apos;) THEN [Genre] END' />
