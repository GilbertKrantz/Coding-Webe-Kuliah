hist(df$HDI, breaks = 30, col = 'blue', main = 'Histogram of HDI', xlab = "HDI")
hist(df$`FDI (USD)`, breaks = 30, col = 'red', main = 'Histogram of FDI (USD)', xlab = 'FDI (USD)')
hist(df$`Portofolio Investment`, breaks = 30, col = 'green', main = 'Histogram of Portofolio Investment', xlab = 'Portofolio Investment')
hist(df$`Jumlah UMKM Indonesia`, breaks = 30, col = 'purple', main = 'Histogram of Jumlah UMKM Indonesia', xlab = 'Jumlah UMKM Indonesia')
df <- subset(df, select = -(Years, Tahun))
# Splitting the data into independent and dependent variables
X <- df[, c('HDI', 'FDI (USD)', 'Portofolio Investment', 'Jumlah UMKM Indonesia')]
y <- df$'GDP (USD)'
# Creating an instance of the LinearRegression model
model <- train(X, y, method = 'lm')
# Performing the forecast
forecast <- predict(model, X)
# Creating a new data frame for comparison
comparison_df <- data.frame('Actual GDP' = y, 'Forecasted GDP' = forecast)
# Creating a line plot
ggplot(comparison_df, aes(x = rownames(comparison_df), y = comparison_df$'Actual GDP')) +
geom_line(color = 'blue') +
geom_line(aes(y = comparison_df$'Forecasted GDP'), color = 'red') +
labs(title = 'Actual vs. Forecasted GDP', x = 'Index', y = 'GDP (USD)') +
theme_minimal()
